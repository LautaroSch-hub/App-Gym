# PostgreSQL connection URL. Use the URL provided by your database provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Use a random secret of at least 16 characters for JWT signing.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret

# Optional. Defaults to America/Argentina/Buenos_Aires.
GYM_TIMEZONE=America/Argentina/Buenos_Aires
